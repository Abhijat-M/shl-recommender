# --- LLM (pick ONE provider; both are wired and either works) ---

# Option A: Google Gemini (recommended free tier — 15 RPM, 1M TPM)
# Get a key at https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash-lite      # most generous free tier; sub-second latency
# Alternatives that also work on free tier (different RPM/TPM):
#   gemini-2.5-flash, gemini-flash-latest, gemini-2.0-flash

# Option B: Groq (alternative — fast, but 12k TPM cap on free tier)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_groq_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Service ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=1                # 0 for human-readable logs

# --- Retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K_DENSE=25
TOP_K_SPARSE=25
TOP_K_FINAL=10
RRF_K=60

# --- Agent limits (must respect SHL evaluator) ---
MAX_TURNS=8
LLM_TIMEOUT_SECONDS=20

# --- Catalog ---
CATALOG_PATH=data/catalog/catalog.json
INDEX_DIR=data/index
SHL_CATALOG_BASE_URL=http://www.shl.com/products/product-catalog/

# --- Rate limit (per client IP; in-process token bucket) ---
RATE_LIMIT_BURST=10
RATE_LIMIT_RPS=1

# --- CORS (comma-separated; '*' allows all) ---
ALLOWED_ORIGINS=*
